{% extends '@SurvosTabler/layout/base.html.twig' %}

{% block page_title %}AI Workflow Subjects{% endblock %}

{% block content %}

{# ── Filters ───────────────────────────────────────────────────────────────── #}
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label">Scope</label>
                <select name="scope" class="form-select form-select-sm">
                    <option value="">All</option>
                    {% for s in scopes %}
                        <option value="{{ s }}" {{ activeScope == s ? 'selected' : '' }}>{{ s }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label">Type</label>
                <select name="subjectType" class="form-select form-select-sm">
                    <option value="">All</option>
                    {% for t in subjectTypes %}
                        <option value="{{ t }}" {{ activeType == t ? 'selected' : '' }}>{{ t }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label">Marking</label>
                <select name="marking" class="form-select form-select-sm">
                    <option value="">All</option>
                    {% for m in markings %}
                        <option value="{{ m }}" {{ activeMarking == m ? 'selected' : '' }}>{{ m }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary">Filter</button>
                <a href="{{ path('survos_ai_workflow_subjects') }}" class="btn btn-sm btn-secondary ms-1">Reset</a>
            </div>
        </form>
    </div>
</div>

{# ── Subject grid ──────────────────────────────────────────────────────────── #}
{% if subjects is empty %}
    <div class="empty">
        <div class="empty-title">No subjects found</div>
        <div class="empty-subtitle text-secondary">Import JSONL records to create Subject rows.</div>
    </div>
{% else %}
    <div class="row row-cards">
        {% for subject in subjects %}
            {% set dto   = subject.dto() %}
            {% set title = dto.label %}
            {% set date  = dto.date %}
            {% set desc  = dto.description %}
            {% set showParams = {id: subject.id} %}
            {% if activeScope %}
                {% set showParams = showParams|merge({scope: activeScope}) %}
            {% endif %}
            {% if activeType %}
                {% set showParams = showParams|merge({subjectType: activeType}) %}
            {% endif %}
            {% if activeMarking %}
                {% set showParams = showParams|merge({marking: activeMarking}) %}
            {% endif %}

            <div class="col-sm-6 col-lg-4 col-xl-3">
                <div class="card card-sm">
                    {% if dto.iiifBase %}
                        <a href="{{ path('survos_ai_workflow_subject', showParams) }}"
                           class="d-block text-center" style="background: #f4f6fa;">
                            <img src="{{ dto.iiifBase|imgproxy('observe') }}"
                                 class="d-block mx-auto"
                                 style="max-width: 100%; max-height: 240px; width: auto; height: auto; object-fit: contain;"
                                 alt="{{ title }}"
                                 loading="lazy">
                        </a>
                    {% endif %}
                    <div class="card-body p-2">
                        <div class="d-flex align-items-start justify-content-between mb-1">
                            <a href="{{ path('survos_ai_workflow_subject', showParams) }}"
                               class="text-body fw-semibold small text-truncate"
                               style="max-width: 80%;"
                               title="{{ title }}">
                                {{ title }}
                            </a>
                            <span class="badge bg-{{ subject.marking in ['analyzed','reviewed','published'] ? 'success' : (subject.marking == 'observed' ? 'azure' : (subject.marking == 'prepared' ? 'primary' : 'secondary')) }}-lt ms-1 flex-shrink-0">
                                {{ subject.marking }}
                            </span>
                        </div>
                        {% if date or desc %}
                            <div class="text-secondary" style="font-size: .75rem; line-height: 1.3;">
                                {% if date %}<span class="me-1">{{ date }}</span>{% endif %}
                                {% if desc %}{{ desc|slice(0, 80) }}{% if desc|length > 80 %}…{% endif %}{% endif %}
                            </div>
                        {% endif %}
                        {% set tasks = tasksRun[subject.workflowSubjectId] ?? [] %}
                        {% if tasks is not empty %}
                            <div class="mt-1 d-flex flex-wrap gap-1">
                                {% for task in tasks %}
                                    <span class="badge bg-blue-lt" style="font-size: .65rem;">{{ task }}</span>
                                {% endfor %}
                            </div>
                        {% endif %}
                        <div class="text-muted mt-1" style="font-size: .7rem;">
                            <code>{{ subject.subjectId }}</code>
                            {% if subject.scope %} · {{ subject.scope }}{% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
    <p class="text-secondary mt-2 small">Showing {{ subjects|length }} subjects (max 100). Use filters to narrow.</p>
{% endif %}

{% endblock %}

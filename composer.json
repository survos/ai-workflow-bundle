{
    "name": "survos/ai-workflow-bundle",
    "description": "State-bundle workflow primitives for async AI preparation, observation, analysis, and publishing.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "ai", "workflow", "state", "observation", "analysis", "claims"],
    "autoload": {
        "psr-4": {
            "Survos\\AiWorkflowBundle\\": "src/"
        }
    },
    "require": {
        "php": "^8.5",
        "survos/state-bundle": "^2.5",
        "survos/claims-bundle": "^2.5",
        "symfony/dependency-injection": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/messenger": "^8.1",
        "symfony/service-contracts": "^3.6",
        "symfony/twig-bundle": "^8.1",
        "twig/twig": "^3.0",
        "symfony/ai": "dev-tac",
        "symfony/ai-bundle": "^0.10",
        "symfony/ai-agent": "^0.10",
        "symfony/ai-open-ai-platform": "^0.10",
        "symfony/ai-mistral-platform": "^0.10",
        "survos/data-contracts": "^2.5"
    },
    "suggest": {
        "survos/imgproxy-bundle": "Signed imgproxy URL generation — implement AiThumbnailProviderInterface using ImgproxyUrlBuilder"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "survos/tabler-bundle": "^2.5"
    },
    "extra": {
        "symfony": {
            "require": "^8.0"
        }
    }
}
